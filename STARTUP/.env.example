# Copy to .env and set real values before deploying.
# Only HUJJAT_SECRET_KEY is required; everything else has a working default.

# REQUIRED in production — without it, every restart invalidates all sessions.
HUJJAT_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48

HUJJAT_ENVIRONMENT=dev
POSTGRES_PASSWORD=hujjat-local-dev

# Where the browser reaches the API. Baked into the web image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: cloud OCR ------------------------------------------------------
# Leave empty to run entirely in-country on the PDF text layer + Tesseract.
# See docs/data-residency.md before enabling: Vision receives the page image.
HUJJAT_GOOGLE_VISION_API_KEY=

# --- Optional: LLM escalation -------------------------------------------------
# Only OCR text is sent, never the image. Used only below the confidence
# threshold. Leave empty to run on the rule extractor alone.
HUJJAT_LLM_API_KEY=
HUJJAT_EXTRACTION_STRATEGY=auto

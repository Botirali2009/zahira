# Copy to .env and fill in. Never commit .env.

# Anthropic API key for analyzers/llm_analyzer.py.
# If empty, set FEATURE_LLM_ANALYZER=0 — the rule analyzer keeps the demo working.
ANTHROPIC_API_KEY=

# Flask
FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-me
HOST=0.0.0.0
PORT=5000

# SQLite file (relative paths are resolved from the project root)
DB_PATH=hamroh.db

# LLM
# "anthropic" (default, needs ANTHROPIC_API_KEY) or "gemini" (needs
# GEMINI_API_KEY below instead — no Anthropic credit required).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=10
TRIAGE_PROMPT=triage_v1.txt
TRIAGE_CASE_PROMPT=triage_v1_case.txt

# Gemini (analyzers/gemini_analyzer.py) — only read when LLM_PROVIDER=gemini.
# Key: https://aistudio.google.com/api-keys (no card needed for the free tier).
# Model names on the free tier change over time — check
# https://ai.google.dev/gemini-api/docs/pricing before picking one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feature flags (1/0) — defaults live in config.py FEATURES
FEATURE_LLM_ANALYZER=1
FEATURE_DOCTOR_REPLY=1
FEATURE_TREND_CHART=0
FEATURE_SMS_NOTIFIER=0
FEATURE_MULTI_QUESTION=0
# Keep this at 0 until SMARTCALL_API_KEY/SMARTCALL_GROUP_ID below point at a
# real account you control — the seeded demo patients have made-up phone
# numbers, and every red-alert answer in the smoke tests would try to call
# them for real.
FEATURE_CALL_NOTIFIER=0
FEATURE_PUSH_NOTIFICATIONS=1

# SmartCall (callmaster.uz) — automated voice-reminder calls.
# Docs: https://smartcall.uz/web/api/v1 ; groupID comes from the Statistika page.
SMARTCALL_API_KEY=
SMARTCALL_GROUP_ID=
SMARTCALL_API_URL=https://smartcall.uz/web/api/v1
SMARTCALL_TIMEOUT_SECONDS=10

# Web Push (VAPID) — generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=hamroh@example.uz

# Google OAuth2 (Google Cloud Console -> Credentials -> OAuth client ID).
# GOOGLE_REDIRECT_URI must exactly match a URI registered there, e.g.
# https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telegram Login Widget (@BotFather -> /newbot, then /setdomain to your host).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# dmed identity provider is an unimplemented stub — leave off.
FEATURE_DMED_AUTH=0

# Comma-separated emails that get admin rights on login (Module B — manual
# doctor verification at /admin/doctors). Only applies to Google logins,
# since Telegram profiles don't carry an email.
ADMIN_EMAILS=

# Doctor document uploads (diplomas/licenses). Kept outside static/ — served
# only through the permission-checked /files/doctor-documents/<id> route.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
